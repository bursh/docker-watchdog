#!/bin/sh
set -e
if [ "$1" = remove ]; then
    deb-systemd-helper mask docker-watchdog.service >/dev/null || true
fi
if [ "$1" = purge ]; then
    deb-systemd-helper purge docker-watchdog.service >/dev/null || true
    deb-systemd-helper unmask docker-watchdog.service >/dev/null || true
fi
if [ -d /run/systemd/system ]; then
    systemctl daemon-reload || true
fi
