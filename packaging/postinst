#!/bin/sh
set -e
if [ "$1" = configure ]; then
    deb-systemd-helper unmask docker-watchdog.service >/dev/null
    if deb-systemd-helper --quiet was-enabled docker-watchdog.service; then
        deb-systemd-helper enable docker-watchdog.service >/dev/null
    else
        deb-systemd-helper update-state docker-watchdog.service >/dev/null
    fi
    if [ -d /run/systemd/system ]; then
        systemctl daemon-reload
        if command -v docker >/dev/null && docker compose version >/dev/null 2>&1 && systemctl is-active --quiet docker.service; then
            deb-systemd-invoke restart docker-watchdog.service >/dev/null || true
        else
            echo 'Docker Engine or Compose V2 unavailable; start docker-watchdog after Docker is ready.' >&2
        fi
    fi
fi
